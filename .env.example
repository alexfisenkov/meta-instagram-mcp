# Copy this template into the private external config directory described in
# docs/install.md. The portable tools/run.mjs and tools/cli.mjs load it there.
# Keep all credential values empty in this tracked example.
# OAuth mode:
# - unified: new Meta "API setup with Unified login", Meta App ID/Secret + config ID.
# - facebook: existing Page-linked Facebook Login + Instagram Graph API.
# - instagram: only for an app created through "API setup with Instagram login" with a separate Instagram App ID.
META_AUTH_MODE=unified

# Meta App ID/Secret for Unified. See docs/unified-login.md for Dashboard-token setup.
# Legacy Facebook/Instagram Login use their own matching setup and credentials.
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=
# Unified only: numeric configuration ID; HTTPS redirect for OAuth (see docs/unified-login.md).
META_INSTAGRAM_CONFIG_ID=
# Advanced Unified OAuth behind your own TLS proxy: localhost helper port (optional).
# META_OAUTH_CALLBACK_LISTEN_PORT=8787
META_INSTAGRAM_REDIRECT_URI=
META_INSTAGRAM_SCOPES=

# Optional. If set, used before the local token store.
META_INSTAGRAM_ACCESS_TOKEN=

# Optional. Usually saved by meta_resolve_instagram_account after OAuth.
# Set manually only when Meta gives direct Instagram access but declines Page scopes.
META_INSTAGRAM_USER_ID=
META_FACEBOOK_PAGE_ID=

# Optional defaults.
META_GRAPH_API_VERSION=
META_TOKEN_STORE_PATH=

# Publishing safety switch. Only the exact string "true" enables
# meta_publish_media; every call also needs confirm: true.
# Leave empty for a read-only deployment.
META_INSTAGRAM_WRITE=

# Additional confirmation gate required before meta_execute_action performs a delete.
# Keep empty unless delete actions are intentionally enabled for this runtime.
META_INSTAGRAM_DELETE=

# Optional. Publish journal (JSON lines). Defaults to publish-log.jsonl
# next to the token store.
META_INSTAGRAM_PUBLISH_LOG=

# Optional server transport. Default is stdio. HTTP requires a bearer secret
# of at least 32 bytes and should remain on loopback unless protected by a
# trusted reverse proxy and explicit host/origin allowlists.
# INSTAGRAM_MCP_TRANSPORT=http
# INSTAGRAM_MCP_HTTP_HOST=127.0.0.1
# INSTAGRAM_MCP_HTTP_PORT=8787
# INSTAGRAM_MCP_HTTP_BEARER_TOKEN=
# INSTAGRAM_MCP_HTTP_ALLOWED_HOSTS=
# INSTAGRAM_MCP_HTTP_ALLOWED_ORIGINS=
# INSTAGRAM_MCP_HTTP_MAX_REQUEST_BYTES=1048576

# Optional durable state and companion controls. Readiness is reported per
# source; enabling a write flag alone does not authorize an operation.
# INSTAGRAM_MCP_HUB_STATE_PATH=/absolute/private/path/companion-hub.json
# INSTAGRAM_MCP_BROWSER_WRITES=true
# INSTAGRAM_MCP_PHONE_WRITES=true
# INSTAGRAM_MCP_BRIDGE_CONFIG=/absolute/private/path/browser-bridge.json
# INSTAGRAM_MCP_PHONE_CONFIG=/absolute/private/path/phone-companion.json
# INSTAGRAM_MCP_EXTENSION_ID=<installed-extension-id>

# Optional remote proxy. Any non-empty remote setting makes tools/run.mjs use
# this stdio proxy instead of starting a local server. Errors do not fall back.
# Keep the bearer token in the private external config.
# INSTAGRAM_MCP_REMOTE_CONFIG=/absolute/private/path/remote-config.json
# Use an HTTPS origin (legacy, targets /mcp) or an explicit HTTPS MCP endpoint.
# INSTAGRAM_MCP_REMOTE_URL=https://your-mcp.example/instagram-instance/mcp
# INSTAGRAM_MCP_REMOTE_BEARER_TOKEN=

# Optional webhook receiver configuration. A route is mounted only when the
# required account binding and verification token are configured.
# META_WEBHOOK_VERIFY_TOKEN=
# META_WEBHOOK_ACCOUNT_IDS=
# META_WEBHOOK_PATH=/webhook
# META_WEBHOOK_JOURNAL_PATH=/absolute/private/path/webhook-events.jsonl

# Optional Graph API network tuning.
# Optional YouTube student broker provider. Google Web OAuth credentials live
# only in the broker environment; register this redirect URI in Google Cloud.
# YOUTUBE_OAUTH_CLIENT_ID=
# YOUTUBE_OAUTH_CLIENT_SECRET=
# YOUTUBE_OAUTH_REDIRECT_URL=
# META_GRAPH_FALLBACK_IPS=
# META_GRAPH_TIMEOUT_MS=10000
# META_GRAPH_PREFER_FALLBACK=true

# Hosted broker only: do not uncomment in portable MCP config.
# See docs/student-broker.md and docs/social-publishing.md for its separate environment.
# META_BROKER_PUBLISHING_CONFIG_FILE=
# META_BROKER_PUBLISHING_MEDIA_ORIGIN=
# META_BROKER_PUBLISHING_MEDIA_PATH=
# SOCIAL_YOUTUBE_CLIENT_ID=
# SOCIAL_YOUTUBE_CLIENT_SECRET=
# SOCIAL_TIKTOK_CLIENT_ID=
# SOCIAL_TIKTOK_CLIENT_SECRET=
# SOCIAL_PINTEREST_CLIENT_ID=
# SOCIAL_PINTEREST_CLIENT_SECRET=

# Optional isolated read-account providers. Values stay in the private broker environment.
# Existing owned Google Web OAuth client can be reused via config reference names.
# META_BROKER_CONNECTIONS_CONFIG_FILE=
# SOCIAL_TWITCH_CLIENT_ID=
# SOCIAL_TWITCH_CLIENT_SECRET=
# SOCIAL_LINKEDIN_CLIENT_ID=
# SOCIAL_LINKEDIN_CLIENT_SECRET=
# SOCIAL_X_CLIENT_ID=
# SOCIAL_X_CLIENT_SECRET=
