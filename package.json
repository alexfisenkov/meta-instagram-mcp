{
  "name": "meta-instagram-mcp",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Unified Instagram MCP with official Meta API and connected browser/phone companions.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexfisenkov/meta-instagram-mcp.git"
  },
  "homepage": "https://github.com/alexfisenkov/meta-instagram-mcp#readme",
  "bugs": {
    "url": "https://github.com/alexfisenkov/meta-instagram-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "instagram",
    "meta",
    "graph-api",
    "analytics",
    "read-only"
  ],
  "bin": {
    "meta-instagram-mcp": "./dist/server.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node tools/run.mjs",
    "test": "vitest run",
    "test:installer": "node tools/test-installer.mjs",
    "test:native-registration": "node tools/test-native-registration.mjs",
    "test:remote-entrypoint": "node tools/test-remote-entrypoint.mjs",
    "doctor": "node tools/doctor.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "meta:auth-url": "node tools/cli.mjs auth-url",
    "meta:callback": "node tools/cli.mjs callback"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "happy-dom": "20.14.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  },
  "engines": {
    "node": ">=22"
  }
}
